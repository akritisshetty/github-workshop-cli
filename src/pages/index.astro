---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const publishers = await getAllPublishers(db);
const categories = [...new Map(
  games.flatMap((game) => (game.category ? [[game.category.id, game.category.name] as [number, string]] : [])),
)].sort(([, nameA], [, nameB]) => nameA.localeCompare(nameB));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form id="game-filters" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <div class="grid gap-6 lg:grid-cols-3">
          <div>
            <label for="game-search" class="mb-2 block text-sm font-medium text-slate-200">Search by title</label>
            <input
              id="game-search"
              type="search"
              placeholder="Search games"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="game-search"
            />
          </div>

          <fieldset>
            <legend class="mb-2 block text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map(([id, name]) => (
                <label class="flex items-center gap-2 text-sm text-slate-300">
                  <input
                    type="checkbox"
                    value={id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${id}`}
                  />
                  {name}
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <p id="game-filter-status" class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="game-filter-status">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
          <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="reset-game-filters"
          >
            Clear filters
          </button>
        </div>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div id="filtered-empty-state" class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');
  const searchInput = document.querySelector<HTMLInputElement>('#game-search');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const status = document.querySelector<HTMLElement>('#game-filter-status');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('#filtered-empty-state');

  if (form && searchInput && publisherFilter && status && grid && emptyState) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const categoryFilters = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));

    const updateResults = (): void => {
      const search = searchInput.value.trim().toLowerCase();
      const selectedCategories = categoryFilters
        .filter((filter) => filter.checked)
        .map((filter) => filter.value);
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of cards) {
        const title = (card.dataset.gameTitle ?? '').toLowerCase();
        const categoryId = card.dataset.gameCategoryId ?? '';
        const publisherId = card.dataset.gamePublisherId ?? '';
        const matchesSearch = title.includes(search);
        const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(categoryId);
        const matchesPublisher = selectedPublisher === '' || selectedPublisher === publisherId;
        const isVisible = matchesSearch && matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        visibleCount += isVisible ? 1 : 0;
      }

      grid.hidden = visibleCount === 0;
      emptyState.hidden = visibleCount !== 0;
      emptyState.classList.toggle('hidden', visibleCount !== 0);
      status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    };

    form.addEventListener('input', updateResults);
    form.addEventListener('change', updateResults);
    form.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
